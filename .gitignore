# Installed dependencies.
# NOTE: the root node_modules/ is already tracked in this repo; git keeps
# tracking what it already tracks, so this only stops *new* installs (e.g.
# contracts/, frontend/) from being staged by accident.
node_modules/

# Build output / generated caches
contracts/artifacts/artifacts.d.ts
contracts/artifacts/build-info/
contracts/artifacts/**/artifacts.d.ts
contracts/cache/compile-cache.json
contracts/coverage/data/
contracts/coverage/html/
contracts/out/

frontend/.next/
frontend/out/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/tsconfig.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage.xml
htmlcov/
venv/
.venv/

# Local environment
.env
.env.local
