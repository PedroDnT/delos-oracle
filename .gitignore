# Secrets — never commit. Copy the .example files and fill them in locally.
.env
.env.local
.env.production
*.env
!*.env.example

# Installed dependencies.
# NOTE: the root node_modules/ is already tracked in this repo; git keeps
# tracking what it already tracks, so this only stops *new* installs (e.g.
# contracts/, frontend/) from being staged by accident.
node_modules/

# Rust / Anchor build output
target/
.anchor/

# Hardhat build output / generated caches. Regenerated by `hardhat compile`,
# which CI runs before the test jobs — tracking it buries every diff in churn.
contracts/artifacts/
contracts/cache/compile-cache.json
contracts/coverage/data/
contracts/coverage/html/
contracts/out/

# Next.js build output
frontend/.next/
frontend/out/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/tsconfig.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage.xml
htmlcov/
venv/
.venv/

# Agent / editor scratch
.claude/
.planning/
