# Copy to .env.local and fill in. Everything here is NEXT_PUBLIC_ and ships in
# the browser bundle — never put a service-role key or a private key in this file.

# Supabase — the dashboard reads rates straight from the latest_rates view.
# The anon key is public by design; row-level security limits it to read-only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Chain / contracts
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_ORACLE_ADDRESS=0x...
NEXT_PUBLIC_FACTORY_ADDRESS=0x...

# Optional: a real WalletConnect project ID. The app currently falls back to
# "demo", which does not work for production wallet connections.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
