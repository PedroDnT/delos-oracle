# Solana RPC (devnet default)
RPC_URL=https://api.devnet.solana.com

# Path to your Solana keypair JSON (publisher authority)
KEY_PATH=~/.config/solana/id.json

# Program ID after first deploy (update after `anchor deploy`)
PROGRAM_ID=DeLoSXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Set to "true" to fetch data without posting transactions
DRY_RUN=false
